        </mxCell>
        <mxCell id="a_init" parent="a1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" value="ARDUINO_INIT&#xa;Инициализация пинов, энкодеров, таймера 40 Гц" vertex="1">
