        </mxCell>
        <mxCell id="a_idle" parent="a1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" value="STATE_IDLE&#xa;Ожидание команд от RPi&#xa;(Фоновая отправка статуса «Работает» 40 Гц)" vertex="1">
          <mxGeometry height="70" width="270" x="470" y="85" as="geometry" />
        </mxCell>
        <mxCell id="a_calc" parent="a1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" value="STATE_CALC_TICKS&#xa;Расчет тиков поворота и прямой:&#xa;S = pi * theta * L / 360&#xa;T_пов = S * N / C  |  T_пр = d * N / C&#xa;Запуск таймера тиков (t_тиков = 0)" vertex="1">
          <mxGeometry height="90" width="260" x="840" y="75" as="geometry" />
        </mxCell>
        <mxCell id="rot_group" parent="a1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;fontStyle=1;startSize=30;" value="STATE_PHASE_ROTATE (Фаза 1: Поворот на месте на угол theta)" vertex="1">
          <mxGeometry height="250" width="760" x="170" y="230" as="geometry" />
        </mxCell>
        <mxCell id="rot_wd" parent="rot_group" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" value="t_тиков &lt; t_max ?" vertex="1">
