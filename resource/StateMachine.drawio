        </mxCell>
        <mxCell id="rot_check" parent="rot_group" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" value="T_пов.тек &lt; T_пов.зад ?" vertex="1">
          <mxGeometry height="80" width="170" x="230" y="60" as="geometry" />
        </mxCell>
        <mxCell id="rot_sonar" parent="rot_group" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" value="Проверка дальномеров:&#xa;Есть препятствие?" vertex="1">
