        </mxCell>
        <mxCell id="rot_step" parent="rot_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" value="DO_ROTATE_STEP&#xa;Крутим колеса на месте -&gt;&#xa;Принимаем сигнал энкодера -&gt;&#xa;Сброс таймера t_тиков = 0" vertex="1">
